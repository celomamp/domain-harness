.DS_Store

# Dependencies
node_modules

# Build and tool output
dist
*.tsbuildinfo
.turbo
coverage
.react-router

# Local mail outbox for sign-in links (REGISTRY_MAIL_OUTBOX_DIR)
.outbox

# Local env files (secrets never live in the repository)
.env
.env.*
!.env.example
!.env.local.example
# Never commit key material or tenant definitions: provision/company files and
# the staging signing key live outside the repo (see docs/staging.md).
*.pem
*.key
company.json
supabase/.temp

# Debug
npm-debug.log*
pnpm-debug.log*

# Panel end-to-end output (Playwright)
test-results
playwright-report
