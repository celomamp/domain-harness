# Local development only. Copy to `.env.local` for your shell/dotenv workflow:
#   cp .env.local.example .env.local
#
# Every value below is a LOCAL-ONLY DEVELOPMENT CREDENTIAL for a database,
# port, or key bound to your machine. Nothing here is a secret and nothing
# here is ever used outside local development. Real connection strings,
# vendor credentials, and trust keys come from your secret manager.
# No real secret is ever committed: this file is the only place local
# defaults live, and `pnpm local:*` uses these same values when the
# corresponding variable is unset.

# Registry postgres (root compose.yaml, 127.0.0.1:5432). The migrator owns
# the tables; the runtime connects as a member of dh_registry_app, never as
# the owner or a superuser.
REGISTRY_MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
REGISTRY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?options=-c%20role%3Ddh_registry_app
REGISTRY_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Registry HTTP API.
REGISTRY_HTTP_HOST=127.0.0.1
REGISTRY_HTTP_PORT=4100

# The panel's public base URL. Local runs the panel with `pnpm local:serve:panel`
# (panel dev on :5173), so this matches that port.
REGISTRY_PANEL_URL=http://localhost:5173

# Sign-in mail: set exactly one of SMTP or the file outbox. Local default is
# the outbox (one JSON file per message under ./.outbox, gitignored).
REGISTRY_MAIL_OUTBOX_DIR=./.outbox
# REGISTRY_SMTP_URL=smtp://127.0.0.1:2525
# REGISTRY_MAIL_FROM=Domain Harness <no-reply@localhost>

# Local-only bundle signing key (Ed25519 PKCS#8 PEM). There is deliberately
# no default here: a private key must never be committed (a registry tripwire
# fails `pnpm test` when any private key exists in the repository). Leave
# this unset and `pnpm local:keys` (or `pnpm local:serve:registry` /
# `pnpm local:serve` on first use) generates `$HOME/.domain-harness/registry-signing-key.pem`
# (outside the repository, never committed). An explicitly empty value skips
# generation so the registry's own missing_configuration envelope still fires.
# To use your own key instead, uncomment below and paste the PEM
# (`\n` escapes are read as newlines by the serve wrapper) and never commit the file.
# REGISTRY_BUNDLE_SIGNING_KEY=
REGISTRY_BUNDLE_SIGNING_KEY_ID=local-dev-key-1

# Panel: registry API base URL (defaults to http://127.0.0.1:4100 in code).
PANEL_REGISTRY_URL=http://127.0.0.1:4100

# Company service: outbound vendor registry URL.
SERVICE_VENDOR_URL=http://127.0.0.1:4100
# This Company's tenant id (UUIDv7). Replace with the tenantId from the
# registry's provision output; the default below only matches the placeholder
# compose tenant.
SERVICE_TENANT_ID=018f3d2a-7000-7000-8000-000000000100
# Paste from the registry's provision output (`serviceCredential`). There is
# no default: the service refuses to start without it. Never commit a real one.
SERVICE_TENANT_CREDENTIAL=
# Trust set: JSON object of keyId -> Ed25519 PEM public key. Run
# `pnpm local:keys` and paste its trust-set JSON here. There is no default:
# the service refuses to start without real key material (compose fails with
# one sentence). Never commit real keys.
SERVICE_BUNDLE_TRUST_KEYS=
# Record store (service compose record-store, 127.0.0.1:5433; localhost:5433
# from the host, record-store:5432 from inside the service container).
SERVICE_RECORD_DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
SERVICE_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Optional: pull interval in milliseconds (default 60000).
# SERVICE_PULL_INTERVAL_MS=60000

# Guidance server-cli (Company service): same tenant, same record store,
# plus the Read API secret, the registry address/credential, and the
# role-token trust set. The secret below is local-only; never commit a real one.
SERVICE_READ_CREDENTIAL=local-only-read-secret
SERVICE_GUIDANCE_PORT=8080
# Role-token trust set (registry Ed25519 public keys, same JSON shape).
# Paste the `pnpm local:keys` trust-set JSON here as well.
SERVICE_ROLE_TOKEN_TRUST_KEYS=
