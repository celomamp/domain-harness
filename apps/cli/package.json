{
  "name": "@domain-harness/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Offline CLI Gate (Community).",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@domain-harness/contract": "workspace:*",
    "@domain-harness/core": "workspace:*",
    "@domain-harness/gate": "workspace:*"
  },
  "bin": {
    "domain-harness": "./dist/cli.js"
  },
  "devDependencies": {
    "@domain-harness/eslint-config": "workspace:*",
    "@domain-harness/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
